// The plugin interface of Apeiron, version 0.2 (docs/PLUGIN.md §2).
package apeiron:plugin@0.2.0;

// A type driver knows the content of some kinds of files.
interface type-driver {
  record info {
    // Lowercase letters, digits and `-`.
    name: string,
    version: string,
    description: string,
    // File name patterns such as `*.txt`; `*` and `?` as wildcards.
    patterns: list<string>,
    // File name patterns of the files `extract-text` reads; none for a plugin
    // that does not.
    text-patterns: list<string>,
    // Permissions the plugin asks for; this version grants none.
    permissions: list<string>,
  }

  describe: func() -> info;

  // Joins the changes of `ours` and `theirs` since `base`, absent when the
  // file did not exist there. `none` when the changes conflict.
  merge: func(base: option<list<u8>>, ours: list<u8>, theirs: list<u8>) -> result<option<list<u8>>, string>;

  // A difference for people to read, or `none`.
  diff: func(old: list<u8>, new: list<u8>) -> result<option<string>, string>;

  // The text inside a file, for search; `none` when it holds none.
  extract-text: func(content: list<u8>) -> result<option<string>, string>;
}

world type-driver-plugin {
  export type-driver;
}

// An importer reads an archive format Apeiron does not know into files, for
// `apeiron import` (docs/PLUGIN.md §2.1).
interface importer {
  record info {
    // Lowercase letters, digits and `-`.
    name: string,
    version: string,
    description: string,
    // File name patterns of the archives it reads, such as `*.mbox`.
    patterns: list<string>,
    // Permissions the plugin asks for; this version grants none.
    permissions: list<string>,
  }

  // One file of the archive: a `/`-separated path and its content.
  record file {
    path: string,
    content: list<u8>,
  }

  describe: func() -> info;

  // The files inside `content`, or why it cannot read it.
  read: func(content: list<u8>) -> result<list<file>, string>;
}

// A hook looks at an operation before it takes effect and may stop it
// (docs/PLUGIN.md §2.2).
interface hook {
  record info {
    name: string,
    version: string,
    description: string,
    // The events it is called for: `backup`, before a backup's ref moves,
    // and `backup-done`, after it moved.
    events: list<string>,
    permissions: list<string>,
  }

  enum change-kind {
    added,
    removed,
    modified,
  }

  // A path the operation changes. `content` is the new content of an added
  // or changed file of at most 1 MiB.
  record change {
    path: string,
    kind: change-kind,
    content: option<list<u8>>,
  }

  describe: func() -> info;

  // Warnings to show and go on, or why to stop. `settings` is the text the
  // user gave with `apeiron plugin settings`, empty when none.
  check: func(settings: string, event: string, ref-name: string, changes: list<change>) -> result<list<string>, string>;
}

// A storage backend keeps repository copies where Apeiron cannot reach by
// itself, as the remote `plugin://<name>/<config>` (docs/PLUGIN.md §2.3).
// Each call gets the remote's `config` text; paths and refs are those of a
// folder copy (docs/FORMAT.md §15.2).
interface storage {
  record info {
    name: string,
    version: string,
    description: string,
    // `net:<host>` for each host it reaches, granted when it is installed.
    permissions: list<string>,
  }

  variant swap-failure {
    // The ref points elsewhere: its id in hex, or none when it is missing.
    conflict(option<string>),
    failed(string),
  }

  describe: func() -> info;
  read: func(config: string, path: string) -> result<option<list<u8>>, string>;
  read-range: func(config: string, path: string, offset: u64, len: u64) -> result<list<u8>, string>;
  list-dir: func(config: string, dir: string) -> result<list<string>, string>;
  // Writes a new file; one already there is left as it is.
  write-new: func(config: string, path: string, data: list<u8>) -> result<_, string>;
  create-dirs: func(config: string, dirs: list<string>) -> result<_, string>;
  delete: func(config: string, path: string) -> result<_, string>;
  // The ref's snapshot id in hex, or none.
  read-ref: func(config: string, name: string) -> result<option<string>, string>;
  list-refs: func(config: string) -> result<list<string>, string>;
  // Points the ref at `new` only if it points at `expected`, atomically.
  swap-ref: func(config: string, name: string, expected: option<string>, new: string) -> result<_, swap-failure>;
}

world storage-plugin {
  export storage;
}

world importer-plugin {
  export importer;
}

world hook-plugin {
  export hook;
}
