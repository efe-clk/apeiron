{
  "name": "an encrypted repository opens only with its password",
  "steps": [
    {"write": "src/a.txt", "text": "secret"},
    {"init": "repo", "password": "correct horse"},
    {"call": "info", "expect": {"encrypted": true}},
    {"start": "backup", "request": {"source": "$TMP/src", "ref": "main"}, "expect": {"files": 1}},
    {"call": "keys"},
    {"call": "add_recovery_key"},
    {"call": "add_password", "request": {"password": "another good password"}},
    {"open": "repo", "error": "key"},
    {"open": "repo", "password": "wrong", "error": "key"},
    {"open": "repo", "password": "correct horse"},
    {"call": "list", "request": {"snapshot": "main"}, "expect": [{"name": "a.txt", "size": 6}]}
  ]
}
