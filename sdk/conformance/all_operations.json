{
  "name": "every operation answers with what the schema says",
  "steps": [
    {"write": "src/a.txt", "text": "one"},
    {"write": "src/copy.txt", "text": "one"},
    {"write": "work/a.txt", "text": "here"},
    {"write": "work/a (conflict b 2026-10-29 10-00).txt", "text": "there"},
    {"init": "repo"},
    {"start": "backup", "request": {"source": "$TMP/src", "ref": "main"}, "expect": {"files": 2}},
    {"write": "src/a.txt", "text": "two"},
    {"start": "backup", "request": {"source": "$TMP/src", "ref": "main"}},
    {"call": "resolve", "request": {"spec": "main"}},
    {"call": "reflog", "request": {"name": "main"}},
    {"call": "diff_text", "request": {"from": "main~1", "to": "main"}},
    {"call": "duplicates", "request": {"snapshot": "main~1"}},
    {"call": "create_ref", "request": {"name": "side", "snapshot": "main~1"}},
    {"call": "merge", "request": {"from": "main", "into": "side"}},
    {"call": "cherry_pick", "request": {"from": "main", "into": "side"}},
    {"call": "rebase", "request": {"from": "main", "into": "side"}},
    {"call": "repair"},
    {"call": "retention"},
    {"call": "add_retention", "request": {"refs": "archive/*", "days": 1}},
    {"call": "holds"},
    {"call": "add_hold", "request": {"refs": "held/*", "reason": "A case"}},
    {"call": "remotes"},
    {"call": "add_remote", "request": {"name": "disk", "url": "$TMP/copy"}},
    {"start": "push", "request": {"remote": "disk"}},
    {"start": "pull", "request": {"remote": "disk"}},
    {"start": "push_all", "request": {"remote": "disk"}},
    {"start": "pull_all", "request": {"remote": "disk"}},
    {"start": "repair_from", "request": {"remote": "disk"}},
    {"start": "gc_remote", "request": {"remote": "disk", "dry_run": true}},
    {"start": "report", "request": {"remotes": true}},
    {"start": "restore_test", "request": {"snapshot": "main"}},
    {"start": "export", "request": {"snapshot": "main", "output": "$TMP/out.tar"}},
    {"start": "import_archive", "request": {"archive": "$TMP/out.tar", "ref": "imported"}},
    {"call": "prune", "request": {"ref": "imported", "keep_last": 1}},
    {"start": "gc", "request": {"dry_run": true}},
    {"start": "switch", "request": {"snapshot": "main", "folder": "$TMP/switched"}},
    {"start": "sync", "request": {"folder": "$TMP/src", "remote": "disk", "dry_run": true}},
    {"start": "git_export", "request": {"path": "$TMP/git"}},
    {"start": "git_import", "request": {"path": "$TMP/git"}},
    {"call": "plugins", "request": {"dir": "$TMP/plugins"}},
    {"call": "save_search", "request": {"name": "texts", "pattern": "*.txt", "file": "$TMP/searches.json"}},
    {"call": "saved_searches", "request": {"file": "$TMP/searches.json"}},
    {"call": "forget_search", "request": {"name": "texts", "file": "$TMP/searches.json"}},
    {"call": "conflicts", "request": {"folder": "$TMP/work"}, "expect": [{"path": "a.txt"}]},
    {"call": "resolve_conflict", "request": {"folder": "$TMP/work", "copy": "a (conflict b 2026-10-29 10-00).txt", "keep": "this"}},
    {"call": "remove_remote", "request": {"name": "disk"}}
  ]
}
